# OpenAI-compatible API. For the local Cockpit Tools Codex gateway:
PROSPECTUS_LLM_PROVIDER=langchain
LLM_BASE_URL=http://127.0.0.1:58815/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna

# Alternatively set PROSPECTUS_ENV_FILE in the shell to the existing VMChat .env.
# Never commit real API keys or copy secret values into source control.
PROSPECTUS_MAX_UPLOAD_BYTES=41943040
PROSPECTUS_MAX_PAGES=240
PROSPECTUS_MAX_ANALYSIS_CHARS=150000
PROSPECTUS_LLM_TIMEOUT_SECONDS=360
PROSPECTUS_TASK_LOG_DIR=./var/tasks
PROSPECTUS_MAX_DATE_GAP_DAYS=183
PROSPECTUS_MODEL_CONCURRENCY=3
LLM_NETWORK_RETRIES=1
PROSPECTUS_PDF_WORKERS=2
PROSPECTUS_CACHE_ENABLED=1
PROSPECTUS_CACHE_DIR=./var/cache
