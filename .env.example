# Same environment variable names as the VMChat AI shell.
PROSPECTUS_LLM_PROVIDER=langchain
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_API_KEY=
LLM_MODEL=

# Or use the signed-in local OMP CLI without saving prompts as OMP sessions.
PROSPECTUS_OMP_COMMAND=omp
PROSPECTUS_OMP_MODEL=openai-codex/gpt-6-luna

# Alternatively set PROSPECTUS_ENV_FILE in the shell to the existing VMChat .env.
# Never commit real API keys or copy secret values into source control.
PROSPECTUS_MAX_UPLOAD_BYTES=41943040
PROSPECTUS_MAX_PAGES=240
PROSPECTUS_MAX_ANALYSIS_CHARS=150000
PROSPECTUS_LLM_TIMEOUT_SECONDS=180
PROSPECTUS_TASK_LOG_DIR=./var/tasks
